{
  // Used only by ts-jest. The library build (tsconfig.json) keeps rootDir=src
  // and includes only src, so tests never end up in dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["jest", "node"]
  },
  "include": ["src", "test"]
}
