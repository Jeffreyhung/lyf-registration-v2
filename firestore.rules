rules_version = '2';

// Role checks in this file mirror ROLE_CAPABILITIES in schemas/src/admin.ts —
// rules cannot import TS, so when a role or capability changes there, update
// the corresponding hasRole/hasAnyRole calls here and keep validRoles() in sync.
// The matrix is enforced by firestore-rules-tests/ (run against the emulator).
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Identity helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && 'email' in request.auth.token;
    }

    function callerEmail() {
      return request.auth.token.email;
    }

    // ---------- Admin role helpers ----------

    function validRoles() {
      return ['full_admin', 'program_staff', 'health_staff'];
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(callerEmail());
    }

    function callerAdminData() {
      return get(adminDocPath()).data;
    }

    // Fails closed: a missing doc, a disabled admin, or an unrecognized role
    // value all mean "not an admin" — matching resolveAdminRole() in the
    // schemas package and assertAdmin() in functions.
    // Note: rules error (→ deny) on reading a missing property, so optional
    // fields are read with .get(key, default).
    function isAnyAdmin() {
      return hasEmail() &&
        exists(adminDocPath()) &&
        callerAdminData().get('disabled', false) != true &&
        callerAdminData().get('role', '') in validRoles();
    }

    function getRole() {
      return callerAdminData().get('role', '');
    }

    function hasRole(role) {
      return isAnyAdmin() && getRole() == role;
    }

    function hasAnyRole(roles) {
      return isAnyAdmin() && getRole() in roles;
    }

    function isFullAdmin() {
      return hasRole('full_admin');
    }

    // ---------- Family ownership helpers ----------

    function familyEmails(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.emails;
    }

    function isFamilyMember(familyId) {
      return hasEmail() && callerEmail() in familyEmails(familyId);
    }

    function isMemberOfResourceFamily() {
      return hasEmail() && callerEmail() in resource.data.emails;
    }

    // True when an update touches only the listed keys.
    function onlyUpdates(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Fields a parent may set on their own camper. Health and demographics
    // are deliberately absent — they live under private/ and are gated there.
    function camperProfileKeys() {
      return ['firstName', 'lastName', 'preferredName', 'birthDate', 'gender',
              'pronouns', 'email', 'returning', 'registrations', 'schemaVersion'];
    }

    // ---------- Admin roster ----------

    // Read-only from the client. All roster mutations go through the
    // manageAdmin callable (Admin SDK bypasses rules) so the last-full_admin
    // guard and the audit log cannot be skipped.
    // These rules are deployed to both databases and get() cannot cross
    // databases, so the test database holds a copy of the roster kept in
    // sync by the replicateAdminsToTest trigger.
    match /admins/{email} {
      // Any signed-in user can read their own admin doc (how the client
      // learns its role)
      allow read: if hasEmail() && callerEmail() == email;
      // Full admins can read the whole roster
      allow read: if isFullAdmin();
      allow write: if false;
    }

    // ---------- Families ----------

    match /families/{familyId} {
      allow read: if isAnyAdmin() || isMemberOfResourceFamily();
      allow create, delete: if isFullAdmin();
      // Family members may edit address/household details only. `emails`
      // (membership) and `registrations` are function-managed.
      allow update: if isFullAdmin() ||
        (isMemberOfResourceFamily() &&
          onlyUpdates(['street', 'suite', 'city', 'state', 'zip', 'country', 'household']));

      match /parents/{parentId} {
        allow read: if isAnyAdmin() || isFamilyMember(familyId);
        allow write: if isFullAdmin();
      }

      match /campers/{camperId} {
        allow read: if isAnyAdmin() || isFamilyMember(familyId);
        allow write: if isFullAdmin();
        // Parents may add campers and edit profile fields. A new camper
        // cannot arrive with registrations attached.
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.keys().hasOnly(camperProfileKeys()) &&
          (!('registrations' in request.resource.data) ||
            request.resource.data.registrations.size() == 0);
        allow update: if isFamilyMember(familyId) &&
          onlyUpdates(camperProfileKeys().removeAll(['registrations', 'schemaVersion']));

        // Private sub-documents — one match for every sensitive section.
        // Section gates mirror PRIVATE_SECTIONS in schemas/src/families.ts:
        // adding a new section means one condition here, nothing else.
        match /private/{section} {
          allow read: if
            (section == 'health' &&
              (hasAnyRole(['health_staff', 'full_admin']) || isFamilyMember(familyId))) ||
            (section == 'demographics' && isFullAdmin());
          allow write: if isFullAdmin();
          // Parents own their child's health info and may keep it current.
          allow create, update: if section == 'health' &&
            isFamilyMember(familyId) &&
            request.resource.data.keys().hasOnly(['dietAndFoodAllergies', 'medicalConditions']);
        }
      }
    }

    // ---------- Camp years & registrations ----------

    // Any signed-in user can read camp info (pricing, dates, remaining spots)
    match /camps/{campYear} {
      allow read: if isSignedIn();
      allow write: if isFullAdmin();

      match /registrations/{registrationId} {
        allow read: if isAnyAdmin() ||
          (hasEmail() && callerEmail() in resource.data.familyEmails);
        allow create, delete: if isFullAdmin();
        allow update: if isFullAdmin();
        // writeRegistrations capability: program_staff may edit the
        // operational fields the admin console exposes, nothing structural
        // (camper ref, payments, familyEmails, waiver, pricing state).
        allow update: if hasRole('program_staff') &&
          onlyUpdates(['status', 'internalNotes', 'hasContacted', 'isCheckedOut',
                       'nameOfParentCheckedOut', 'checkedOutTime', 'smallGroup',
                       'cabinPreference', 'updatedAt']);
        // Parents may edit what the profile page and checkout flow expose.
        allow update: if hasEmail() &&
          callerEmail() in resource.data.familyEmails &&
          onlyUpdates(['shirtSize', 'additionalNotes', 'isCheckedOut',
                       'nameOfParentCheckedOut', 'checkedOutTime', 'updatedAt']);
      }
    }

    // ---------- Money ----------

    match /payments/{paymentId} {
      allow read, write: if isFullAdmin();
    }

    match /credits/{familyId} {
      allow read, write: if isFullAdmin();
    }

    // ---------- Everything else ----------

    // Server-only collections (_processedEvents, adminAuditLog, ...) and any
    // future collection: full admins may inspect, nobody writes from the
    // client. Add an explicit match above before exposing a new collection.
    match /{document=**} {
      allow read: if isFullAdmin();
      allow write: if false;
    }
  }
}
