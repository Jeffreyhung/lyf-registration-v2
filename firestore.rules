rules_version = '2';

// Role checks in this file mirror ROLE_CAPABILITIES in schemas/src/admin.ts —
// rules cannot import TS, so when a role or capability changes there, update
// the corresponding hasRole/hasAnyRole calls here and keep validRoles() in sync.
// Capabilities that are only exercised through callables (manageAdmins,
// manageCampYear) have no rule here: the matching collections (admins/,
// camps/{year} itself, config/) deny every client write and the function
// enforces the capability with assertAdmin. The matrix is enforced by
// firestore-rules-tests/ (run against the emulator).
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Identity helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && 'email' in request.auth.token;
    }

    function callerEmail() {
      return request.auth.token.email;
    }

    // ---------- Admin role helpers ----------

    function validRoles() {
      return ['full_admin', 'program_admin', 'program_staff', 'health_staff'];
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(callerEmail());
    }

    function callerAdminData() {
      return get(adminDocPath()).data;
    }

    // Fails closed: a missing doc, a disabled admin, or an unrecognized role
    // value all mean "not an admin" — matching resolveAdminRole() in the
    // schemas package and assertAdmin() in functions.
    // Note: rules error (→ deny) on reading a missing property, so optional
    // fields are read with .get(key, default).
    function isAnyAdmin() {
      return hasEmail() &&
        exists(adminDocPath()) &&
        callerAdminData().get('disabled', false) != true &&
        callerAdminData().get('role', '') in validRoles();
    }

    function getRole() {
      return callerAdminData().get('role', '');
    }

    function hasRole(role) {
      return isAnyAdmin() && getRole() == role;
    }

    function hasAnyRole(roles) {
      return isAnyAdmin() && getRole() in roles;
    }

    function isFullAdmin() {
      return hasRole('full_admin');
    }

    // ---------- Family ownership helpers ----------

    function familyEmails(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.emails;
    }

    function isFamilyMember(familyId) {
      return hasEmail() && callerEmail() in familyEmails(familyId);
    }

    function isMemberOfResourceFamily() {
      return hasEmail() && callerEmail() in resource.data.emails;
    }

    // True when an update touches only the listed keys.
    function onlyUpdates(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Field shape helpers ----------
    // The functions validate every document they write through the schemas
    // package. These give the handful of fields parents write straight from
    // the website the same floor: the right type and a sane size, so a map
    // or a megabyte cannot land where the admin grid expects a short string.
    // `keys` is the set of keys to check — every key on a create, only the
    // changed keys on an update — so a legacy value in an untouched field
    // never blocks an unrelated edit. null is accepted wherever text is.

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Keys to check for a create-or-update rule: resource is null on create.
    function writtenKeys() {
      return resource == null ? request.resource.data.keys() : changedKeys();
    }

    function textOk(d, keys, key, max) {
      return !(key in keys) || !(key in d) || d[key] == null ||
        (d[key] is string && d[key].size() <= max);
    }

    function boolOk(d, keys, key) {
      return !(key in keys) || !(key in d) || d[key] is bool;
    }

    function timestampOk(d, keys, key) {
      return !(key in keys) || !(key in d) || d[key] == null ||
        d[key] is timestamp;
    }

    function listOk(d, keys, key, max) {
      return !(key in keys) || !(key in d) ||
        (d[key] is list && d[key].size() <= max);
    }

    function mapOk(d, keys, key) {
      return !(key in keys) || !(key in d) || d[key] is map;
    }

    // Mirrors the camper profile fields in schemas/src/validation.ts.
    function camperProfileShapeOk(d, keys) {
      return textOk(d, keys, 'firstName', 200) &&
        textOk(d, keys, 'lastName', 200) &&
        textOk(d, keys, 'preferredName', 200) &&
        textOk(d, keys, 'birthDate', 50) &&
        listOk(d, keys, 'gender', 20) &&
        textOk(d, keys, 'pronouns', 200) &&
        textOk(d, keys, 'email', 320) &&
        boolOk(d, keys, 'returning');
    }

    function camperHealthShapeOk(d, keys) {
      return textOk(d, keys, 'dietAndFoodAllergies', 5000) &&
        textOk(d, keys, 'medicalConditions', 5000);
    }

    function familyAddressShapeOk(d, keys) {
      return textOk(d, keys, 'street', 200) &&
        textOk(d, keys, 'suite', 200) &&
        textOk(d, keys, 'city', 200) &&
        textOk(d, keys, 'state', 200) &&
        textOk(d, keys, 'zip', 50) &&
        textOk(d, keys, 'country', 200) &&
        mapOk(d, keys, 'household');
    }

    // The registration fields the profile page and camper checkout write.
    function parentRegistrationShapeOk(d, keys) {
      return textOk(d, keys, 'shirtSize', 50) &&
        textOk(d, keys, 'additionalNotes', 5000) &&
        boolOk(d, keys, 'isCheckedOut') &&
        textOk(d, keys, 'nameOfParentCheckedOut', 200) &&
        timestampOk(d, keys, 'checkedOutTime') &&
        timestampOk(d, keys, 'updatedAt');
    }

    // Fields a parent may set on their own camper. Health and demographics
    // are deliberately absent — they live under private/ and are gated there.
    function camperProfileKeys() {
      return ['firstName', 'lastName', 'preferredName', 'birthDate', 'gender',
              'pronouns', 'email', 'returning', 'registrations', 'schemaVersion'];
    }

    // ---------- Admin roster ----------

    // Read-only from the client. All roster mutations go through the
    // manageAdmin callable (Admin SDK bypasses rules) so the last-full_admin
    // guard and the audit log cannot be skipped.
    // These rules are deployed to both databases and get() cannot cross
    // databases, so the test database holds a copy of the roster kept in
    // sync by the replicateAdminsToTest trigger.
    match /admins/{email} {
      // Any signed-in user can read their own admin doc (how the client
      // learns its role)
      allow read: if hasEmail() && callerEmail() == email;
      // Full admins can read the whole roster
      allow read: if isFullAdmin();
      allow write: if false;
    }

    // ---------- Families ----------

    match /families/{familyId} {
      allow read: if isAnyAdmin() || isMemberOfResourceFamily();
      allow create, delete: if isFullAdmin();
      // Family members may edit address/household details only. `emails`
      // (membership) and `registrations` are function-managed.
      allow update: if isFullAdmin() ||
        (isMemberOfResourceFamily() &&
          onlyUpdates(['street', 'suite', 'city', 'state', 'zip', 'country', 'household']) &&
          familyAddressShapeOk(request.resource.data, changedKeys()));

      match /parents/{parentId} {
        allow read: if isAnyAdmin() || isFamilyMember(familyId);
        allow write: if isFullAdmin();
      }

      match /campers/{camperId} {
        allow read: if isAnyAdmin() || isFamilyMember(familyId);
        allow write: if isFullAdmin();
        // Parents may add campers and edit profile fields. A new camper
        // cannot arrive with registrations attached.
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.keys().hasOnly(camperProfileKeys()) &&
          (!('registrations' in request.resource.data) ||
            request.resource.data.registrations.size() == 0) &&
          camperProfileShapeOk(request.resource.data, request.resource.data.keys());
        allow update: if isFamilyMember(familyId) &&
          onlyUpdates(camperProfileKeys().removeAll(['registrations', 'schemaVersion'])) &&
          camperProfileShapeOk(request.resource.data, changedKeys());

        // Private sub-documents — one match for every sensitive section.
        // Section gates mirror PRIVATE_SECTIONS in schemas/src/families.ts:
        // adding a new section means one condition here, nothing else.
        match /private/{section} {
          allow read: if
            (section == 'health' &&
              (hasAnyRole(['health_staff', 'full_admin']) || isFamilyMember(familyId))) ||
            (section == 'demographics' && isFullAdmin());
          allow write: if isFullAdmin();
          // Parents own their child's health info and may keep it current.
          allow create, update: if section == 'health' &&
            isFamilyMember(familyId) &&
            request.resource.data.keys().hasOnly(['dietAndFoodAllergies', 'medicalConditions']) &&
            camperHealthShapeOk(request.resource.data, writtenKeys());
        }
      }
    }

    // ---------- Site config & camp years ----------

    // Which camp year the site is registering / pre-registering for. Read by
    // the time gates before sign-in, so it must be public. Written only by the
    // manageCampYear callable (manageCampYear capability).
    match /config/site {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Camp years & registrations ----------

    // Camp info (dates, pricing, remaining spots) is public: the registration
    // and pre-registration pages decide whether they are open from these dates
    // before the visitor signs in. Nothing personal may live on this document.
    // Writes go through the manageCampYear callable (dates/fees/caps) and the
    // registration functions (remainingSpots).
    match /camps/{campYear} {
      allow read: if true;
      allow write: if false;

      // Registration-close bypass list, one document per email so a parent
      // can confirm only their own extension and never enumerate the list.
      // Admins may list it (the Camp Year tab); manageCampYear writes it.
      match /private/bypass/emails/{email} {
        allow read: if isAnyAdmin() || (hasEmail() && callerEmail() == email);
        allow write: if false;
      }

      // Any other camps/{year}/private/* path falls through to the root
      // catch-all: full_admin may inspect, nobody writes from the client.

      match /registrations/{registrationId} {
        allow read: if isAnyAdmin() ||
          (hasEmail() && callerEmail() in resource.data.familyEmails);
        allow create, delete: if isFullAdmin();
        allow update: if isFullAdmin();
        // writeRegistrations capability: program_staff and program_admin may
        // edit the operational fields the admin console exposes, nothing
        // structural (camper ref, payments, familyEmails, waiver, pricing state).
        allow update: if hasAnyRole(['program_staff', 'program_admin']) &&
          onlyUpdates(['status', 'internalNotes', 'hasContacted', 'isCheckedOut',
                       'nameOfParentCheckedOut', 'checkedOutTime', 'smallGroup',
                       'cabinPreference', 'updatedAt']);
        // Parents may edit what the profile page and checkout flow expose.
        allow update: if hasEmail() &&
          callerEmail() in resource.data.familyEmails &&
          onlyUpdates(['shirtSize', 'additionalNotes', 'isCheckedOut',
                       'nameOfParentCheckedOut', 'checkedOutTime', 'updatedAt']) &&
          parentRegistrationShapeOk(request.resource.data, changedKeys());
      }
    }

    // ---------- Money ----------

    match /payments/{paymentId} {
      allow read, write: if isFullAdmin();
    }

    match /credits/{familyId} {
      allow read, write: if isFullAdmin();
    }

    // ---------- Everything else ----------

    // Server-only collections (_processedEvents, adminAuditLog, ...) and any
    // future collection: full admins may inspect, nobody writes from the
    // client. Add an explicit match above before exposing a new collection.
    match /{document=**} {
      allow read: if isFullAdmin();
      allow write: if false;
    }
  }
}
