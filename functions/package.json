{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "lint-fix": "eslint --ext .js,.ts . --fix",
    "copy-files": "copyfiles -u 1 ./src/**/*.html ./lib && copyfiles -u 1 ./src/**/*.mjml ./lib",
    "build": "tsc && yarn copy-files",
    "build:watch": "tsc --watch",
    "serve": "yarn run build && firebase emulators:start --only functions",
    "shell": "yarn run build && firebase functions:shell",
    "start": "yarn run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "isolate": "isolate",
    "test": "yarn --cwd ../schemas build && jest"
  },
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@sentry/node": "^10.52.0",
    "@slack/client": "^5.0.2",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.0.3",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1",
    "firebase-tools": "^13.11.4",
    "global": "^4.4.0",
    "lyf-registration-schemas": "1.0.0",
    "md5": "^2.3.0",
    "mjml": "^4.15.3",
    "mustache": "^4.2.0",
    "nodemailer": "^6.9.1",
    "really-relaxed-json": "^0.3.2",
    "stripe": "^14.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/mailchimp__mailchimp_marketing": "^3.0.6",
    "@types/md5": "^2.3.5",
    "@types/mjml": "^4.7.4",
    "@types/mjml-core": "^4.15.2",
    "@types/mustache": "^4.2.5",
    "@types/nodemailer": "^6.4.7",
    "@typescript-eslint/eslint-plugin": "^7.14.01",
    "@typescript-eslint/parser": "^7.14.1",
    "copyfiles": "^2.4.1",
    "eslint": "^10.3.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-react": "^7.37.5",
    "firebase-functions-test": "3.3.0",
    "globals": "^17.6.0",
    "isolate-package": "^1.18.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
